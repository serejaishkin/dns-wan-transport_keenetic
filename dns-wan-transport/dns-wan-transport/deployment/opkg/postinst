#!/bin/sh

echo "Configuring Keenetic Proxy-Client interface via Internal RCI HTTP API..."

# Используем RCI HTTP порт 79 ядра Keenetic для безопасной передачи команд конфигурации
RCI_URL="http://127.0.0.1:79/rci"

# 1. Создаем интерфейс Proxy0
curl -s -X POST "${RCI_URL}/interface/Proxy0" -d '{}' > /dev/null || true

# 2. Настраиваем параметры прокси-клиента SOCKS5
curl -s -X POST "${RCI_URL}/interface/Proxy0/proxy" -d '{"name":"dns-transport-bridge","type":"socks5","address":"127.0.0.1","port":11000}' > /dev/null || true

# 3. Поднимаем интерфейс
curl -s -X POST "${RCI_URL}/interface/Proxy0/up" -d '{}' > /dev/null || true

# 4. Сохраняем конфигурацию в постоянную память Keenetic
curl -s -X POST "${RCI_URL}/system/configuration/save" -d '{}' > /dev/null || true

echo "Proxy0 interface successfully registered via RCI API!"
exit 0
