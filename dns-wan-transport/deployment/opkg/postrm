#!/bin/sh

echo "Cleaning dns-wan-transport configuration via Internal RCI HTTP API..."
RCI_URL="http://127.0.0.1:79/rci"

curl -s -X POST "${RCI_URL}/interface/Proxy0/down" -d '{}' > /dev/null || true
curl -s -X DELETE "${RCI_URL}/interface/Proxy0" > /dev/null || true
curl -s -X POST "${RCI_URL}/system/configuration/save" -d '{}' > /dev/null || true

echo "Proxy0 interface successfully cleared from KeeneticOS!"
exit 0
